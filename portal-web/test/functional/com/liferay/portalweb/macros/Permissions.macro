definition {

	@summary = "Default summary"
	macro addBlogsEntryLoginUserPG(entryInvalidContent = null, viewableBySelection = null, siteName = null, vocabularyName = null, entryAddRelatedAsset = null, tagName = null, userLoginEmailAddress = null, pageName = null, categoryName = null, assetType = null, entryAddCategory = null, viewableBy = null, entryAddTag = null, siteURLTemp = null, entryValidTitleLength = null, entryInvalidTitleLength = null, assetTitle = null, entryInvalidTitle = null, userLoginFullName = null, entryTitle = null, entryContent = null, entryAddPermissions = null) {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");

		if (${siteURLTemp} == "true") {
			Navigator.gotoSitePage(
				pageName = ${pageName},
				siteName = ${siteName});
		}
		else {
			Navigator.gotoPage(pageName = ${pageName});
		}

		Blogs.addEntry(
			assetTitle = ${assetTitle},
			assetType = ${assetType},
			categoryName = ${categoryName},
			entryAddCategory = ${entryAddCategory},
			entryAddPermissions = ${entryAddPermissions},
			entryAddRelatedAsset = ${entryAddRelatedAsset},
			entryAddTag = ${entryAddTag},
			entryContent = ${entryContent},
			entryInvalidContent = ${entryInvalidContent},
			entryInvalidTitle = ${entryInvalidTitle},
			entryInvalidTitleLength = ${entryInvalidTitleLength},
			entryTitle = ${entryTitle},
			entryValidTitleLength = ${entryValidTitleLength},
			tagName = ${tagName},
			viewableBy = ${viewableBy},
			viewableBySelection = ${viewableBySelection},
			vocabularyName = ${vocabularyName});

		User.logoutAndLoginPG(
			userLoginEmailAddress = ${userLoginEmailAddress},
			userLoginFullName = ${userLoginFullName});
	}

	@summary = "Default summary"
	macro addDMFolderLoginUserPG(viewableBy = null, dmFolderDescription = null, dmFolder = null, dmFolderName = null, userLoginFullName = null, userLoginEmailAddress = null, pageName = null) {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");

		Navigator.gotoPage(pageName = ${pageName});

		DMFolder.addPG(
			dmFolder = ${dmFolder},
			dmFolderDescription = ${dmFolderDescription},
			dmFolderName = ${dmFolderName},
			viewableBy = ${viewableBy});

		User.logoutAndLoginPG(
			userLoginEmailAddress = ${userLoginEmailAddress},
			userLoginFullName = ${userLoginFullName});
	}

	@summary = "Default summary"
	macro definePermissionCP(permissionDefinitionKey = null, roleTitle = null, permissionDefinitionValue = null, permissionNavigationValue = null, roleType = null) {
		ApplicationsMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Roles");

		Role.definePermissionCP(
			permissionDefinitionKey = ${permissionDefinitionKey},
			permissionDefinitionValue = ${permissionDefinitionValue},
			permissionNavigationValue = ${permissionNavigationValue},
			roleTitle = ${roleTitle},
			roleType = ${roleType});
	}

	@summary = "Default summary"
	macro definePermissionLoginUserCP(permissionDefinitionKey = null, roleTitle = null, permissionDefinitionValue = null, permissionNavigationValue = null, userLoginFullName = null, roleType = null, userLoginEmailAddress = null) {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");

		Permissions.definePermissionCP(
			permissionDefinitionKey = ${permissionDefinitionKey},
			permissionDefinitionValue = ${permissionDefinitionValue},
			permissionNavigationValue = ${permissionNavigationValue},
			roleTitle = ${roleTitle},
			roleType = ${roleType});

		User.logoutAndLoginPG(
			userLoginEmailAddress = ${userLoginEmailAddress},
			userLoginFullName = ${userLoginFullName});
	}

	@summary = "Default summary"
	macro definePermissionViaJSONAPI(resourceAction = null, groupName = null, roleTitle = null, resourceName = null, roleType = null) {
		JSONPermission.addPermission(
			actionId = ${resourceAction},
			groupName = ${groupName},
			name = ${resourceName},
			roleTitle = ${roleTitle},
			roleType = ${roleType});
	}

	@summary = "Default summary"
	macro removePermissionCP(permissionDefinitionKey = null, roleTitle = null, permissionDefinitionValue = null, permissionNavigationValue = null, roleType = null) {
		ApplicationsMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Roles");

		Role.removePermissionCP(
			permissionDefinitionKey = ${permissionDefinitionKey},
			permissionDefinitionValue = ${permissionDefinitionValue},
			permissionNavigationValue = ${permissionNavigationValue},
			roleTitle = ${roleTitle},
			roleType = ${roleType});
	}

	@summary = "Default summary"
	macro removePermissionLoginUserCP(permissionDefinitionKey = null, roleTitle = null, permissionDefinitionValue = null, permissionNavigationValue = null, userLoginFullName = null, roleType = null, userLoginEmailAddress = null) {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");

		Permissions.removePermissionCP(
			permissionDefinitionKey = ${permissionDefinitionKey},
			permissionDefinitionValue = ${permissionDefinitionValue},
			permissionNavigationValue = ${permissionNavigationValue},
			roleTitle = ${roleTitle},
			roleType = ${roleType});

		User.logoutAndLoginPG(
			userLoginEmailAddress = ${userLoginEmailAddress},
