	@summary = "Default summary"
	macro gotoSitepageCP(privacy = null, pageName = null) {
		SitePages.togglePrivacy(privacy = ${privacy});

		WaitForLiferayEvent.initializeLiferayEventLog();

		SitePages.gotoPageMenuItem(
			menuItem = "Permissions",
			pageName = ${pageName});

		IFrame.selectPermissionsFrame();
	}

	@summary = "Default summary"
	macro gotoSiteTeamsCP(teamName = null, siteScopeName = null, portletName = null) {
		Navigator.openSiteURL(siteName = ${siteScopeName});

		ProductMenu.gotoPortlet(
			category = "People",
			portlet = ${portletName});

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Permissions",
			rowEntry = ${teamName});

		SelectFrame(locator1 = "IFrame#MODAL_BODY");
	}

