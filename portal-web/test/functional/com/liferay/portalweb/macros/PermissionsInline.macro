definition {

	@summary = "Default summary"
	macro addOrRemoveAccessPermissionFromAllRoles(addOrRemoveViewPermission = null, roleList = null) {
		for (var roleTitle : list ${roleList}) {
			var roleTitle = ${roleTitle};

			var key_roleTitle = StringUtil.replace(${roleTitle}, " ", "-");

			var key_roleTitle = StringUtil.lowerCase(${key_roleTitle});

			if (${addOrRemoveViewPermission} == "Add") {
				Check(locator1 = "Permissions#CONFIGURATION_PERMISSIONS_ACCESS_CHECKBOX");
			}
			else if (${addOrRemoveViewPermission} == "Remove") {
				Uncheck(locator1 = "Permissions#CONFIGURATION_PERMISSIONS_ACCESS_CHECKBOX");
			}
		}

		Button.clickSave();

		AssertTextEquals.assertPartialText(
			locator1 = "Message#SUCCESS",
			value1 = "Your request completed successfully.");
	}

	@summary = "Default summary"
	macro addOrRemoveAnyPermissionsFromSpecificRole(addOrRemoveViewPermission = null, roleTitle = null, permissionsKeyList = null) {
		var key_roleTitle = StringUtil.replace(${roleTitle}, " ", "-");

		var key_roleTitle = StringUtil.lowerCase(${key_roleTitle});

		SelectFrameTop(value1 = "relative=top");

		SelectFrame(locator1 = "IFrame#MODAL_BODY");

		if (${addOrRemoveViewPermission} == "Add") {
			for (var permissionDefinitionKey : list ${permissionsKeyList}) {
				Check(locator1 = "Permissions#${permissionDefinitionKey}");
			}
		}
		else if (${addOrRemoveViewPermission} == "Remove") {
			for (var permissionDefinitionKey : list ${permissionsKeyList}) {
				Uncheck(locator1 = "Permissions#${permissionDefinitionKey}");
			}
		}

		Button.clickSave();

		AssertTextEquals.assertPartialText(
			locator1 = "Message#SUCCESS",
			value1 = "Your request completed successfully.");
	}

