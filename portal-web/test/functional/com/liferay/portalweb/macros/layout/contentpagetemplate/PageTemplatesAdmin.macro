definition {

	@summary = "Default summary"
	macro _addPageTemplate(pageTemplateType = null, siteTemplate = null, pageTemplateName = null) {
		if (isSet(pageTemplateType)) {
			var menuItem = ${pageTemplateType};
		}
		else {
			var menuItem = "Content Page Template";
		}

		if (${siteTemplate} == "true") {
			LexiconEntry.gotoAdd();
		}
		else {
			LexiconEntry.gotoAddMenuItem(menuItem = ${menuItem});
		}

		PortletEntry.inputName(name = ${pageTemplateName});

		Button.clickSave();
	}

	@summary = "Default summary"
	macro _gotoAddCollection() {
		if (IsElementPresent(locator1 = "NavNested#NAV_NESTED_PLUS")) {
			Click(locator1 = "NavNested#NAV_NESTED_PLUS");
		}
		else {
			Button.click(button = "New");
		}
	}

	@summary = "Default summary"
	macro addCollection(collectionDescription = null, collectionName = null) {
		PageTemplatesAdmin._gotoAddCollection();

		Collection.editCollection(
			collectionDescription = ${collectionDescription},
			collectionName = ${collectionName});

		Button.clickSave();
	}

	@summary = "Default summary"
	macro addDuplicatePageTemplate(pageTemplateType = null, siteTemplate = null, pageTemplateName = null, menuItem = null) {
		PageTemplatesAdmin._addPageTemplate(
			menuItem = ${menuItem},
			pageTemplateName = ${pageTemplateName},
			pageTemplateType = ${pageTemplateType},
			siteTemplate = ${siteTemplate});

		AssertTextEquals(
			locator1 = "Message#ERROR_MODAL_CONTENT",
			value1 = "A page template entry with that name already exists.");
	}

	@summary = "Default summary"
	macro addPageTemplate(pageTemplateType = null, siteTemplate = null, pageTemplateName = null, menuItem = null) {
		PageTemplatesAdmin._addPageTemplate(
			menuItem = ${menuItem},
			pageTemplateName = ${pageTemplateName},
			pageTemplateType = ${pageTemplateType},
			siteTemplate = ${siteTemplate});

		if (${pageTemplateType} == "Content Page Template") {
			PageEditor.assertFragmentSidebarLoaded();
		}
	}

	@summary = "Default summary"
	macro configureWidgetPageTemplateLayout(columnName = null) {
		Click.pauseClickAt(locator1 = "ControlMenu#EDIT_COG");

		Click(
			key_columnName = ${columnName},
			locator1 = "SitePagesEditPage#LAYOUT_CARD");

		PortletEntry.save();
	}

	@summary = "Default summary"
	macro deletePageTemplate(pageTemplateName = null) {
		LexiconCard.delete(card = ${pageTemplateName});
	}

	@summary = "Default summary"
	macro gotoPageTemplate(pageTemplateName = null) {
		LexiconCard.clickCardTitle(card = ${pageTemplateName});
	}

	@summary = "Default summary"
	macro gotoPageTemplateEllipsisItem(item = null, pageTemplateName = null) {
		LexiconCard.clickEllipsisItem(
			card = ${pageTemplateName},
			item = ${item});
	}

	@summary = "Default summary"
	macro openPageTemplatesAdmin(siteURLKey = null) {
		Navigator.openWithAppendToBaseURL(urlAppend = "group/${siteURLKey}/~/control_panel/manage?p_p_id=com_liferay_layout_admin_web_portlet_GroupPagesPortlet&_com_liferay_layout_admin_web_portlet_GroupPagesPortlet_tabs1=page-templates");
	}

	@summary = "Default summary"
	macro renamePageTemplate(newPageTemplateName = null, pageTemplateName = null) {
		PageTemplatesAdmin.gotoPageTemplateEllipsisItem(
			item = "Rename",
			pageTemplateName = ${pageTemplateName});

		PortletEntry.inputName(name = ${newPageTemplateName});

		Modal.save();
	}

	@summary = "Default summary"
	macro viewPageTemplateNotPresent(pageTemplateName = null) {
		LexiconCard.viewCardNotPresent(card = ${pageTemplateName});
	}

	@summary = "Default summary"
	macro viewPageTemplatePresent(pageTemplateName = null) {
		LexiconCard.viewCardPresent(card = ${pageTemplateName});
	}

}