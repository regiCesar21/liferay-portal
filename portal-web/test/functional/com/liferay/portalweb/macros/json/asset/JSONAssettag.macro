definition {

	@summary = "Default summary"
	macro addTag(groupName = null, site = null, tagName = null) {
		Variables.assertDefined(parameterList = "${groupName},${tagName}");

		var groupId = JSONAssettagSetter.setGroupId(
			groupName = ${groupName},
			site = ${site});

		JSONAssettagAPI._addTag(
			groupId = ${groupId},
			tagName = ${tagName});
	}

}