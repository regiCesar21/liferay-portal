definition {

	@summary = "Default summary"
	macro blacklistModuleAndComponentConfiguration(symbolicName = null, label = null) {
		Type(
			key_label = ${label},
			locator1 = "TextArea#ANY_LABELED",
			value1 = ${symbolicName});

		SystemSettings.saveConfiguration();
	}

	@summary = "Default summary"
	macro viewProductMenuBlacklistedModule(portlet = null, consoleText = null, panel = null, category = null) {
		ApplicationsMenuHelper.openApplicationsMenu();

		Navigator.gotoNavTab(navTab = ${panel});

		AssertElementNotPresent(
			key_category = ${category},
			key_portlet = ${portlet},
			locator1 = "ApplicationsMenu#PORTLET",
			value1 = ${portlet});

		AssertConsoleTextPresent(value1 = ${consoleText});
	}

}