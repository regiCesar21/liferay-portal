	@summary = "Default summary"
	macro viewWithStructureCP(fieldName = null, fieldName2 = null, webContentTitleEscapeCharacter = null, webContentWebContentFieldName = null, description = null, webContentLinkToPage = null, webContentDocumentsAndMedia = null, webContentHTML = null, webContentText = null, webContentInteger = null, webContentImage = null, webContentTextBoxList = null, webContentNumber = null, webContentTextBoxFieldName = null, webContentTextBox2 = null, webContentColor = null, webContentDate = null, webContentWebContent = null, webContentDecimal = null, webContentLinkToPageFieldName = null, webContentRadio = null, webContentBoolean = null, webContentTitle = null, webContentDocumentsAndMediaFieldName = null, webContentSelect = null) {
		if (!(isSet(predefinedValue))) {
			LexiconEntry.changeDisplayStyle(displayStyle = "list");

			WebContentNavigator.gotoEditCP(
				webContentTitle = ${webContentTitle},
				webContentTitleEscapeCharacter = ${webContentTitleEscapeCharacter});

			AssertTextEquals(
				locator1 = "TextInput#TITLE",
				value1 = ${webContentTitle});

			if (isSet(description)) {
				SelectFrame.selectFrameNoLoading(
					key_fieldLabel = "Summary",
					locator1 = "CKEditor#BODY_FIELD_IFRAME_WEB_CONTENT_ARTICLE");

				AssertTextEquals(
					locator1 = "CKEditor#BODY",
					value1 = ${description});

				SelectFrameTop(value1 = "relative=top");
			}
		}

		if (isSet(webContentBoolean)) {
			if (${webContentBoolean} == "true") {
				FormFields.viewCheckboxChecked(fieldName = "Boolean");
			}
			else if (${webContentBoolean} == "false") {
				FormFields.viewCheckboxNotChecked(fieldName = "Boolean");
			}
		}

		if (isSet(webContentColor)) {
			AssertAttributeValue(
				attribute1 = "style",
				key_fieldName = "Color",
				locator1 = "TextInput#SELECTOR_INPUT",
				value1 = ${webContentColor});
		}

		if (isSet(webContentDate)) {
			AssertAttributeValue(
				attribute1 = "value",
				key_fieldLabel = "Date",
				locator1 = "WCEditWebContent#TEXT_INPUT_FIELD",
				value1 = ${webContentDate});
		}

		if (isSet(webContentDecimal)) {
			AssertTextEquals(
				key_fieldLabel = "Decimal",
				locator1 = "WCEditWebContent#TEXT_INPUT_FIELD",
				value1 = ${webContentDecimal});
		}

		if (isSet(webContentDocumentsAndMedia)) {
			AssertAttributeValue(
				attribute1 = "value",
				key_fieldName = ${webContentDocumentsAndMediaFieldName},
				locator1 = "TextInput#SELECTOR_INPUT",
				value1 = ${webContentDocumentsAndMedia});
		}

		if (isSet(webContentHTML)) {
			SelectFrame.selectFrameNoLoading(
				key_fieldLabel = "HTML",
				locator1 = "CKEditor#BODY_FIELD_IFRAME_WEB_CONTENT_ARTICLE");

			AssertTextEquals(
				locator1 = "CKEditor#BODY",
				value1 = ${webContentHTML});

			SelectFrameTop();
		}

		if (isSet(webContentImage)) {
			AssertAttributeValue(
				attribute1 = "value",
				key_fieldName = "Image",
				locator1 = "TextInput#SELECTOR_INPUT",
				value1 = ${webContentImage});

			AssertVisible(locator1 = "Button#PREVIEW");
		}

		if (isSet(webContentInteger)) {
			AssertTextEquals(
				key_fieldLabel = "Integer",
				locator1 = "WCEditWebContent#TEXT_INPUT_FIELD",
				value1 = ${webContentInteger});
		}

		if (isSet(webContentLinkToPage)) {
			AssertAttributeValue(
				attribute1 = "value",
				key_fieldName = ${webContentLinkToPageFieldName},
				locator1 = "TextInput#SELECTOR_INPUT",
				value1 = ${webContentLinkToPage});
		}

		if (isSet(webContentNumber)) {
			AssertTextEquals(
				key_fieldLabel = "Number",
				locator1 = "WCEditWebContent#TEXT_INPUT_FIELD",
				value1 = ${webContentNumber});
		}

		if (isSet(webContentRadio)) {
			FormFields.viewRadioValue(
				fieldName = "Radio",
				fieldValue = ${webContentRadio});
		}

		if (isSet(webContentSeparator)) {
			AssertVisible(
				key_fieldName = "Separator",
				locator1 = "DDMField#SEPARATOR");
		}

		if (isSet(webContentSelect)) {
			AssertSelectedLabel(
				key_fieldLabel = "Select",
				locator1 = "Select#GENERIC_SELECT_FIELD",
				value1 = ${webContentSelect});
		}

		if (isSet(webContentText)) {
			AssertTextEquals(
				key_fieldName = "Text",
				locator1 = "TextInput#DDM",
				value1 = ${webContentText});
		}

		if (isSet(webContentTextBox)) {
			if (isSet(fieldName)) {
				var actual = TestUtils.getElementTextContent(element = "//div[contains(@data-fieldname,'${fieldName}')]//textarea");

				TestUtils.assertEquals(
					actual = ${actual},
					expected = ${webContentTextBox});
			}
			else if (isSet(webContentTextBoxFieldName)) {
				var actual = TestUtils.getElementTextContent(element = "//div[contains(@data-fieldname,'${webContentTextBoxFieldName}')]//textarea");

				TestUtils.assertEquals(
					actual = ${actual},
					expected = ${webContentTextBox});
			}
			else {
				var actual = TestUtils.getElementTextContent(element = "//div[contains(@data-fieldname,'TextBox')]//textarea");

				TestUtils.assertEquals(
					actual = ${actual},
					expected = ${webContentTextBox});
			}
		}

		if (isSet(webContentTextBox2)) {
			var actual = TestUtils.getElementTextContent(element = "//div[contains(@data-fieldname,'${fieldName2}')]//textarea");

			TestUtils.assertEquals(
				actual = ${actual},
				expected = ${webContentTextBox2});
		}

		if (isSet(webContentTextBoxList)) {
			var count = 1;

			for (var webContentTextBox : list ${webContentTextBoxList}) {
				var actual = TestUtils.getElementTextContent(element = "//div[contains(@data-fieldname,'heading${count}')]//textarea");

				TestUtils.assertEquals(
					actual = ${actual},
					expected = ${webContentTextBox});

				var count = ${count} + 1;
			}
		}

		if (isSet(webContentWebContent)) {
			AssertAttributeValue(
				attribute1 = "value",
				key_fieldName = ${webContentWebContentFieldName},
				locator1 = "TextInput#SELECTOR_INPUT",
				value1 = ${webContentWebContent});
		}
	}

