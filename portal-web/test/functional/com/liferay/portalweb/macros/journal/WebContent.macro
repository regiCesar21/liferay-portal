	@summary = "Default summary"
	macro viewChangeDefaultLanguageCP(webContentDescription = null, webContentText = null, webContentInteger = null, webContentTitle = null, webContentTitleEscapeCharacter = null, webContentContent = null, otherLocaleSummary = null, webContentNumber = null, webContentTextBox = null, webContentDocumentsAndMedia = null, webContentHTML = null, webContentDecimal = null) {
		if (isSet(webContentTitleEscapeCharacter)) {
