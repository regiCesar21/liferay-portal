			fieldLabel = "Text Field",
			fieldName = "TextField");

		FormFields.editText(
			fieldName = "TextField",
			fieldValue = "Text Field Value");

		FormPortlet.submit();

		Form.viewRedirectedURL(friendlyURL = "http://localhost:8080/web/guest");
	}

