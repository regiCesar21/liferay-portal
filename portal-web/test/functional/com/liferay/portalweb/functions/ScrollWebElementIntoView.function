@default = "scrollWebElementIntoView"
definition {

	function scrollWebElementIntoView() {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, "true");

		selenium.scrollWebElementIntoView(${locator1});

		selenium.assertJavaScriptErrors("true");

		selenium.assertLiferayErrors();
	}

	function scrollWebElementIntoViewTop(locator1) {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, "true");

		var javascript = '''
var element = document.evaluate("${locator1}", document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;

element.scrollIntoView(true);
		''';

		selenium.executeJavaScript(${value1}, ${value2}, ${value3});

		selenium.assertJavaScriptErrors("true");

		selenium.assertLiferayErrors();
	}

}