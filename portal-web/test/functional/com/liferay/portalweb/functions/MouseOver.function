@default = "mouseOver"
@summary = "Mouse over '${locator1}'"
definition {

	function javaScriptMouseOver() {
		WaitForSPARefresh();

		selenium.javaScriptMouseOver(${locator1});

		selenium.assertJavaScriptErrors("true");

		selenium.assertLiferayErrors();
	}

	function mouseOver() {
		WaitForSPARefresh();

		selenium.waitForVisible(${locator1}, "true");

		selenium.mouseOver(${locator1});

		selenium.assertJavaScriptErrors("true");

		selenium.assertLiferayErrors();
	}

	function mouseOverInvisible() {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, "true");

		selenium.mouseOver(${locator1});

		selenium.assertJavaScriptErrors("true");

		selenium.assertLiferayErrors();
	}

	function mouseOverNotVisible() {
		WaitForSPARefresh();

		selenium.waitForElementPresent(${locator1}, "true");

		selenium.mouseOver(${locator1});

		selenium.waitForVisible(${locator1}, "true");

		selenium.assertJavaScriptErrors("true");

		selenium.assertLiferayErrors();
	}

}