@Library('WorkflowCiSharedLib') _

def osbAsahBackendImage
def osbAsahBatchCuratorImage
def osbAsahComposerImage
def osbAsahDataflowJavaImage
def osbAsahPerformanceTestImage
def osbAsahPublisherImage
def osbAsahSparkPythonImage
def osbAsahStreamCuratorImage
def osbAsahUpgradeImage

pipeline {
	agent {
		kubernetes {
			label 'java'
		}
	}

	environment {
		GIT_HASH = "${sh(script: 'git rev-parse --short=7 ${GIT_COMMIT}', returnStdout: true).trim()}"
		JAVA_HOME = "${JAVA_21_HOME}"
		LABEL_BUILD_DATE = "${sh(script: 'date -u +%Y-%m-%dT%H:%M:%SZ', returnStdout: true).trim()}"
		IMAGE_NAME = "liferaycloud/com-liferay-osb-asah-private"

		DOCKER_BUILD_ARGS = "--build-arg GIT_HASH=${GIT_HASH} --build-arg LABEL_BUILD_DATE=${LABEL_BUILD_DATE} --build-arg LABEL_VCS_REF=${GIT_COMMIT} --file ./Dockerfile --no-cache ./"
		IMAGE_TAG_SUFFIX = "${sh(script: 'date +%Y%m%d', returnStdout: true).trim()}-${GIT_HASH}"
	}

	stages {
		stage('Build') {
			steps {
				sh './gradlew clean assemble -Dinclude.spark.python=true'

				dir('osb-asah-composer') {
					sh 'mkdir -p docker-resources/src/main'

					sh 'cp -R src/main/python docker-resources/src/main'
				}

				dir('osb-asah-dataflow-java') {
					sh '../gradlew clean shadowJar'

					sh 'mkdir -p docker-resources/build/libs'

					sh 'cp build/libs/osb-asah-dataflow-java-all.jar docker-resources/build/libs/osb-asah-dataflow-java.jar'
				}

				dir('osb-asah-spark-python') {
					sh 'cp -R build docker-resources/build'

					sh 'mkdir -p docker-resources/src/main'

					sh 'cp -R src/main/resources docker-resources/src/main'
				}
			}
		}

		stage('Build Docker Images') {
			steps {
				dir('osb-asah-backend') {
					script {
						osbAsahBackendImage = docker.build(
							"${IMAGE_NAME}:osb-asah-backend-${IMAGE_TAG_SUFFIX}",
							"${DOCKER_BUILD_ARGS}")
					}
				}

				dir('osb-asah-batch-curator') {
					script {
						osbAsahBatchCuratorImage = docker.build(
							"${IMAGE_NAME}:osb-asah-batch-curator-${IMAGE_TAG_SUFFIX}",
							 "${DOCKER_BUILD_ARGS}")
					}
				}

				dir('osb-asah-composer') {
					script {
						osbAsahComposerImage = docker.build(
							"${IMAGE_NAME}:osb-asah-composer-${IMAGE_TAG_SUFFIX}",
							 "${DOCKER_BUILD_ARGS}")
					}
				}

				dir('osb-asah-dataflow-java') {
					script {
						osbAsahDataflowJavaImage = docker.build(
							"${IMAGE_NAME}:osb-asah-dataflow-java-${IMAGE_TAG_SUFFIX}",
							 "${DOCKER_BUILD_ARGS}")
					}
				}

				dir('osb-asah-performance-test') {
					script {
						osbAsahPerformanceTestImage = docker.build(
							"${IMAGE_NAME}:osb-asah-performance-test-${IMAGE_TAG_SUFFIX}",
							"--file ./Dockerfile --no-cache ../")
					}
				}

				dir('osb-asah-publisher') {
					script {
						osbAsahPublisherImage = docker.build(
							"${IMAGE_NAME}:osb-asah-publisher-${IMAGE_TAG_SUFFIX}",
							"${DOCKER_BUILD_ARGS}")
					}
				}

				dir('osb-asah-spark-python') {
					script {
						osbAsahSparkPythonImage = docker.build(
							"${IMAGE_NAME}:osb-asah-spark-python-${IMAGE_TAG_SUFFIX}",
							"${DOCKER_BUILD_ARGS}")
					}
				}

				dir('osb-asah-stream-curator') {
					script {
						osbAsahStreamCuratorImage = docker.build(
							"${IMAGE_NAME}:osb-asah-stream-curator-${IMAGE_TAG_SUFFIX}",
							"${DOCKER_BUILD_ARGS}")
					}
				}

				dir('osb-asah-upgrade') {
					script {
						osbAsahUpgradeImage = docker.build(
							"${IMAGE_NAME}:osb-asah-upgrade-${IMAGE_TAG_SUFFIX}",
							"${DOCKER_BUILD_ARGS}")
					}
				}
			}
		}

		stage('Prisma Cloud Scan') {
			steps {
				prismaScanImage([
					osbAsahBackendImage.imageName(),
					osbAsahBatchCuratorImage.imageName(),
					osbAsahComposerImage.imageName(),
					osbAsahDataflowJavaImage.imageName(),
					osbAsahPerformanceTestImage.imageName(),
					osbAsahPublisherImage.imageName(),
					osbAsahSparkPythonImage.imageName(),
					osbAsahStreamCuratorImage.imageName(),
					osbAsahUpgradeImage.imageName()
				])
			}
		}

		stage('Push Docker Images') {
			steps {
				script {
					withDockerRegistry([credentialsId: "dockerhub", url: ""]) {
						osbAsahBackendImage.push()
						osbAsahBatchCuratorImage.push()
						osbAsahComposerImage.push()
						osbAsahDataflowJavaImage.push()
						osbAsahPerformanceTestImage.push()
						osbAsahPublisherImage.push()
						osbAsahSparkPythonImage.push()
						osbAsahStreamCuratorImage.push()
						osbAsahUpgradeImage.push()
					}
				}
			}
		}
	}
}