<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.2.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_2_0.dtd">

<service-builder mvcc-enabled="true" package-path="com.liferay.osb.provisioning.license">
	<namespace>Provisioning</namespace>
	<entity local-service="true" name="CommonLicenseKey" remote-service="true" uuid="true">

		<!-- PK fields -->

		<column name="commonLicenseKeyId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />

		<!-- Other fields -->

		<column name="productGroup" type="String" />
		<column name="productEnvironment" type="String" />
		<column name="productVersion" type="String" />
		<column name="startDate" type="Date" />
		<column name="endDate" type="Date" />
		<column name="fileName" type="String" />
		<column name="fileSize" type="long" />

		<!-- Order -->

		<order>
			<order-column name="endDate" order-by="asc" />
		</order>

		<!-- Finder methods -->

		<finder name="ProductGroup" return-type="Collection">
			<finder-column name="productGroup" />
		</finder>
		<finder name="FileName" return-type="CommonLicenseKey">
			<finder-column name="fileName" />
		</finder>
		<finder name="PG_PE_PV_gtS_ltE" return-type="Collection">
			<finder-column name="productGroup" />
			<finder-column name="productEnvironment" />
			<finder-column name="productVersion" />
			<finder-column comparator="&lt;" name="startDate" />
			<finder-column comparator="&gt;" name="endDate" />
		</finder>
	</entity>
	<entity local-service="true" name="LicenseEntry" remote-service="true">

		<!-- PK fields -->

		<column name="licenseEntryId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="productKey" type="String" />
		<column name="name" type="String" />
		<column name="type" type="String" />
		<column name="versionMin" type="String" />
		<column name="versionMax" type="String" />

		<!-- Order -->

		<order by="asc">
			<order-column case-sensitive="false" name="name" />
		</order>

		<!-- Finder methods -->

		<finder name="ProductKey" return-type="Collection">
			<finder-column name="productKey" />
		</finder>
		<finder name="LikeName" return-type="Collection">
			<finder-column comparator="LIKE" name="name" />
		</finder>
		<finder name="Type" return-type="Collection">
			<finder-column name="type" />
		</finder>
		<finder name="PK_T" return-type="LicenseEntry" unique="true">
			<finder-column name="productKey" />
			<finder-column name="type" />
		</finder>
	</entity>
	<entity local-service="true" name="LicenseKey" remote-service="true" uuid="true">

		<!-- PK fields -->

		<column name="licenseKeyId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userUuid" type="String" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedUserUuid" type="String" />
		<column name="modifiedUserName" type="String" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="assetReceiptLicenseUuid" type="String" />
		<column name="accountKey" type="String" />
		<column name="productPurchaseKey" type="String" />
		<column name="licenseEntryId" type="long" />
		<column name="productKey" type="String" />
		<column name="accountName" type="String" />
		<column name="licenseEntryName" type="String" />
		<column name="licenseEntryType" type="String" />
		<column name="licenseVersion" type="int" />
		<column name="productName" type="String" />
		<column name="productId" type="String" />
		<column name="productVersion" type="String" />
		<column name="clusterId" type="long" />
		<column name="name" type="String" />
		<column name="owner" type="String" />
		<column name="maxClusterNodes" type="int" />
		<column name="maxServers" type="int" />
		<column name="maxConcurrentUsers" type="long" />
		<column name="maxUsers" type="long" />
		<column name="maxHttpSessions" type="int" />
		<column name="sizing" type="String" />
		<column name="description" type="String" />
		<column name="hostName" type="String" />
		<column name="ipAddresses" type="String" />
		<column name="macAddresses" type="String" />
		<column name="serverId" type="String" />
		<column name="key" type="String" />
		<column name="startDate" type="Date" />
		<column name="expirationDate" type="Date" />
		<column name="additionalInfo" type="String" />
		<column name="complimentary" type="boolean" />
		<column name="active" type="boolean" />

		<!-- Order -->

		<order>
			<order-column name="active" order-by="desc" />
			<order-column name="licenseKeyId" order-by="asc" />
		</order>

		<!-- Finder methods -->

		<finder name="ARLU_A" return-type="Collection">
			<finder-column name="assetReceiptLicenseUuid" />
			<finder-column name="active" />
		</finder>
		<finder name="PPK_CI" return-type="Collection">
			<finder-column name="productPurchaseKey" />
			<finder-column name="clusterId" />
		</finder>
		<finder name="PI_SI" return-type="Collection">
			<finder-column name="productId" />
			<finder-column name="serverId" />
		</finder>
		<finder name="ARLU_C_A" return-type="Collection">
			<finder-column name="assetReceiptLicenseUuid" />
			<finder-column name="complimentary" />
			<finder-column name="active" />
		</finder>
		<finder name="PPK_C_A" return-type="Collection">
			<finder-column name="productPurchaseKey" />
			<finder-column name="complimentary" />
			<finder-column name="active" />
		</finder>
		<finder name="PN_SI_A" return-type="Collection">
			<finder-column name="productName" />
			<finder-column name="serverId" />
			<finder-column name="active" />
		</finder>
		<finder name="ARLU_PI_SI_A" return-type="Collection">
			<finder-column name="assetReceiptLicenseUuid" />
			<finder-column name="productId" />
			<finder-column name="serverId" />
			<finder-column name="active" />
		</finder>
	</entity>
	<exceptions>
		<exception>DuplicateCommonLicenseKey</exception>
		<exception>DuplicateIPAddress</exception>
		<exception>DuplicateMACAddress</exception>
		<exception>LicenseEntryName</exception>
		<exception>LicenseEntryVersion</exception>
		<exception>LicenseKeyActive</exception>
		<exception>LicenseKeyDate</exception>
		<exception>LicenseKeyDescription</exception>
		<exception>LicenseKeyIPAddress</exception>
		<exception>LicenseKeyMACAddress</exception>
		<exception>LicenseKeyMaxClusterNodes</exception>
		<exception>LicenseKeyName</exception>
		<exception>LicenseKeyOwner</exception>
		<exception>LicenseKeyProductPurchaseKey</exception>
		<exception>LicenseKeyProductVersion</exception>
		<exception>LicenseKeyServerId</exception>
		<exception>LicenseKeyServerInfo</exception>
	</exceptions>
</service-builder>