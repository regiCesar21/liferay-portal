<html>
    <head>
        <style>
            a:active, a:link, a:visited {
                color: #0b5fff;
                text-decoration: none;
            }

            .access-message {
                color: #272833;
                font-size: 16px;
                font-weight: 600;
                line-height: 150%;
                margin-bottom: 8px;
            }

            .body {
                display: block;
                font-family: 'Source Sans Pro', sans-serif;
                font-style: normal;
                padding: 0px;
                position: relative;
                width: 598px;
            }

            .button {
                align-items: center;
                background: #0b5fff;
                border-radius: 8px;
                height: 40px;
                justify-content: center;
                margin-bottom: 8px;
                padding: 16px 16px;
            }

            .button-text {
                color: #fff;
                font-size: 16px;
                font-weight: 600;
                line-height: 150%;
            }

            .caution-message {
                color: #0b5fff;
                font-size: 24px;
                font-weight: 600;
                line-height: 117%;
                text-align: center;
            }

            .divider {
                background: #6b6c7e;
                height: 1px;
                margin-bottom: 16px;
                margin-top: 16px;
                width: 598px;
            }

            .end-message {
                color: #000000;
                font-size: 24px;
                font-weight: 700;
                line-height: 125%;
            }

            .end-message-box {
                background: #f1f2f5;
                border-radius: 4px;
                margin-bottom: 8px;
                margin-top: 8px;
                padding: 40px 48px;
                text-align: center;
            }

            .footer {
                text-align: center;
                padding: 0px 48px;
                margin-top: 8px;
            }

            .footer-message {
                color: #6b6c7e;
                font-size: 14px;
                font-weight: 400;
                line-height: 150%;
                margin-bottom: 16px;
                margin-top: 16px;
            }

            .footer-navigation {
                color: #6b6c7e;
                display: inline-block;
                font-size: 12px;
                font-weight: 400;
                line-height: 150%;
                margin-bottom: 32px;
                margin-top: 32px;
                padding: 0px;
                text-align: center;
            }

            .get-started-message {
                color: #6b6c7e;
                font-size: 14px;
                font-weight: 400;
                line-height: 150%;
                padding: 0px;
            }

            .get-started-message a:active,
            .get-started-message a:link,
            .get-started-message a:visited {
                color: #6b6c7e;
                text-decoration: underline;
            }

            .header {
                margin-bottom: 16px;
                text-align: center;
                width: 598px;
            }

            .info-message-box {
                background: #eef2fa;
                border-radius: 10px;
                color: #272833;
                font-weight: 400;
                font-size: 14px;
                isolation: isolate;
                line-height: 150%;
                margin-bottom: 32px;
                margin-top: 32px;
                padding: 40px;
            }

            .info-message-box a:active,
            .info-message-box a:link,
            .info-message-box a:visited {
                text-decoration-line: underline;
            }

            .invitation-message {
