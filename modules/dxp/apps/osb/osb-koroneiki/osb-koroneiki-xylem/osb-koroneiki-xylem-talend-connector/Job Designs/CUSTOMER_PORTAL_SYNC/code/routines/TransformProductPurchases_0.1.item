package routines;

import java.util.ArrayList;
import java.util.Date;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import routines.system.JSONArray;
import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class TransformProductPurchases {

	public static String STATUS_APPROVED = "Approved";

	public static String SUBSCRIPTION_NAME_BACKUP = "Backup";

	public static JSONObject getCommerceJSONObject(
			String accountId, String channelId, String productPurchases)
		throws Exception {

		Date now = new Date();

		Map<String, JSONObject> orderMap = new HashMap<>();
		JSONArray orderItemsJSONArray = new JSONArray();

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			if (!_isActive(jsonObject.getString("status"))) {
				continue;
			}

			String accountKey = jsonObject.getString("accountKey");
			Date endDate = DateUtil.parseEndDate(jsonObject);
			Date originalEndDate = DateUtil.parseOriginalEndDate(jsonObject);
			JSONArray productConsumptionsJSONArray = jsonObject.getJSONArray(
				"productConsumptions");
			String productPurchaseKey = jsonObject.getString("key");

			int quantity = jsonObject.getInt("quantity");

			if (quantity > 10000) {
				quantity = 10000;
			}

			Date startDate = DateUtil.parseStartDate(jsonObject);

			JSONObject propertiesJSONObject = jsonObject.getJSONObject(
				"properties");

			String instanceSize = propertiesJSONObject.optString("sizing");

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			JSONObject productPropertiesJSONObject =
				productJSONObject.getJSONObject("properties");

			String displayGroupName = productPropertiesJSONObject.optString(
				"display-group-name");
			String displayName = productPropertiesJSONObject.optString(
				"display-name");

			if (displayGroupName.isEmpty()) {
				continue;
			}

			if (displayName.isEmpty()) {
				displayName = productJSONObject.getString("name");
			}

			// Order

			String orderExternalReferenceCode = _getOpportunityKey(
				accountKey, jsonObject);

			if (!orderMap.containsKey(orderExternalReferenceCode)) {
				JSONObject orderJSONObject = new JSONObject();

				orderJSONObject.put("accountId", accountId);
				orderJSONObject.put("channelId", channelId);
				orderJSONObject.put(
					"currencyCode", Constants.CURRENCY_CODE_USD);
				orderJSONObject.put(
					"externalReferenceCode", orderExternalReferenceCode);
				orderJSONObject.put("orderStatus", Constants.ORDER_STATUS_OPEN);
				orderJSONObject.put(
					"paymentStatus", Constants.ORDER_STATUS_OPEN);

				orderMap.put(orderExternalReferenceCode, orderJSONObject);
			}

			// Order Item

			JSONObject orderItemJSONObject = new JSONObject();

			JSONArray customFieldsJSONArray = new JSONArray();

			customFieldsJSONArray.put(
				_getCustomFieldJSONObject(
					"accountSubscriptionGroupERC",
					_getAccountSubscriptionGroupERC(
						accountKey, displayGroupName)));
			customFieldsJSONArray.put(
				_getCustomFieldJSONObject(
					"accountSubscriptionERC",
					_getAccountSubscriptionERC(
						accountKey, displayGroupName, displayName)));
			customFieldsJSONArray.put(
				_getCustomFieldJSONObject(
					"provisionedCount", productConsumptionsJSONArray.length()));

			String subscriptionTermStatus = null;

			if ((endDate != null) && endDate.before(now)) {
				subscriptionTermStatus = "Expired";
			}
			else if ((startDate != null) && startDate.after(now)) {
				subscriptionTermStatus = "Future";
			}
			else {
				subscriptionTermStatus = "Active";
			}

			customFieldsJSONArray.put(
				_getCustomFieldJSONObject("status", subscriptionTermStatus));

			orderItemJSONObject.put("customFields", customFieldsJSONArray);

			orderItemJSONObject.put(
				"externalReferenceCode", productPurchaseKey);
			orderItemJSONObject.put(
				"orderExternalReferenceCode", orderExternalReferenceCode);
			orderItemJSONObject.put(
				"skuExternalReferenceCode", productJSONObject.get("key"));

			JSONObject optionsJSONObject = new JSONObject();

			optionsJSONObject.put("endDate", DateUtil.format(originalEndDate));
			optionsJSONObject.put("instanceSize", instanceSize);
			optionsJSONObject.put("startDate", DateUtil.format(startDate));

			// Extra space so Liferay component won't interpret it as a JSONObject

			orderItemJSONObject.put(
				"options", optionsJSONObject.toString() + " ");

			orderItemJSONObject.put("quantity", quantity);

			orderItemsJSONArray.put(orderItemJSONObject);
		}

		JSONObject commerceJSONObject = new JSONObject();

		JSONArray ordersJSONArray = new JSONArray();

		for (JSONObject orderJSONObject : orderMap.values()) {
			ordersJSONArray.put(orderJSONObject);
		}

		commerceJSONObject.put("orders", ordersJSONArray);

		commerceJSONObject.put("orderItems", orderItemsJSONArray);

		return commerceJSONObject;
	}

	public static JSONArray getSubscriptionGroupsJSONArray(
			String externalLinks, String productPurchases)
		throws Exception {

		Map<String, List<JSONObject>> subscriptionGroupsMap = new HashMap<>();

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			if (!_isActive(jsonObject.getString("status"))) {
				continue;
			}

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			JSONObject propertiesJSONObject = productJSONObject.getJSONObject(
				"properties");

			String displayGroupName = propertiesJSONObject.optString(
				"display-group-name");

			if (displayGroupName.isEmpty()) {
				continue;
			}

			List<JSONObject> productPurchaseJSONObjects =
				subscriptionGroupsMap.get(displayGroupName);

			if (productPurchaseJSONObjects == null) {
				productPurchaseJSONObjects = new ArrayList<>();

				subscriptionGroupsMap.put(
					displayGroupName, productPurchaseJSONObjects);
			}

			productPurchaseJSONObjects.add(jsonObject);
		}

		JSONArray subscriptionGroupsJSONArray = new JSONArray();

		for (Map.Entry<String, List<JSONObject>> entry :
				subscriptionGroupsMap.entrySet()) {

			String subscriptionGroupName = entry.getKey();

			List<JSONObject> productPurchaseJSONObjects = entry.getValue();

			if (productPurchaseJSONObjects.isEmpty()) {
				continue;
			}

			SubscriptionGroup subscriptionGroup = new SubscriptionGroup(
				subscriptionGroupName, productPurchaseJSONObjects,
				externalLinks);

			subscriptionGroupsJSONArray.put(subscriptionGroup.toJSONObject());
		}

		return subscriptionGroupsJSONArray;
	}

	private static String _getAccountSubscriptionERC(
		String accountKey, String displayGroupName, String displayName) {

		return _getAccountSubscriptionGroupERC(accountKey, displayGroupName) +
			"_" +
				displayName.toLowerCase(
				).replace(
					" ", "-"
				);
	}

	private static String _getAccountSubscriptionGroupERC(
		String accountKey, String displayGroupName) {

		return accountKey + "_" +
			displayGroupName.toLowerCase(
			).replace(
				" ", "-"
			);
	}

	private static JSONObject _getCustomFieldJSONObject(String name, int data) {
		JSONObject customFieldJSONObject = new JSONObject();

		customFieldJSONObject.put("name", name);

		JSONObject customValueJSONObject = new JSONObject();

		customValueJSONObject.put("data", data);

		customFieldJSONObject.put("customValue", customValueJSONObject);

		return customFieldJSONObject;
	}

	private static JSONObject _getCustomFieldJSONObject(
		String name, String data) {

		JSONObject customFieldJSONObject = new JSONObject();

		customFieldJSONObject.put("name", name);

		JSONObject customValueJSONObject = new JSONObject();

		customValueJSONObject.put("data", data);

		customFieldJSONObject.put("customValue", customValueJSONObject);

		return customFieldJSONObject;
	}

	private static String _getOpportunityKey(
		String accountKey, JSONObject productPurchaseJSONObject) {

		if (productPurchaseJSONObject.isNull("externalLinks")) {
			return accountKey;
		}

		JSONArray externalLinksJSONArray =
			productPurchaseJSONObject.getJSONArray("externalLinks");

		for (int j = 0; j < externalLinksJSONArray.length(); j++) {
			JSONObject externalLinkJSONObject =
				externalLinksJSONArray.getJSONObject(j);

			String domain = externalLinkJSONObject.getString("domain");
			String entityName = externalLinkJSONObject.getString("entityName");

			if (domain.equals(Constants.EXTERNAL_LINK_DOMAIN_SALESFORCE) &&
				entityName.equals(
					Constants.
						EXTERNAL_LINK_ENTITY_NAME_SALESFORCE_OPPORTUNITY)) {

				return accountKey + "_" +
					externalLinkJSONObject.getString("entityId");
			}
		}

		return accountKey;
	}

	private static boolean _isActive(String status) throws Exception {
		if ((status == null) ||
			status.equals(ProductConstants.PURCHASE_STATUS_CANCELLED)) {

			return false;
		}

		return true;
	}

	private static class Subscription {

		public Subscription(
			String accountKey, String productKey, String displayGroupName,
			String name) {

			this.accountKey = accountKey;
			this.productKey = productKey;
			this.name = name;

			this.accountSubscriptionGroupExternalReferenceCode =
				_getAccountSubscriptionGroupERC(accountKey, displayGroupName);
			this.externalReferenceCode = _getAccountSubscriptionERC(
				accountKey, displayGroupName, name);
		}

		public void addSubscriptionTerm(JSONObject jsonObject)
			throws Exception {

			Date now = new Date();

			SubscriptionTerm subscriptionTerm = new SubscriptionTerm(
				accountSubscriptionGroupExternalReferenceCode,
				externalReferenceCode, jsonObject);

			if (subscriptionTerm.status.equals(STATUS_APPROVED)) {
				if ((startDate == null) ||
					startDate.after(subscriptionTerm.startDate)) {

					startDate = subscriptionTerm.startDate;
				}

				if ((endDate == null) ||
					endDate.before(subscriptionTerm.endDate)) {

					endDate = subscriptionTerm.endDate;
				}

				if ((originalEndDate == null) ||
					originalEndDate.before(subscriptionTerm.originalEndDate)) {

					originalEndDate = subscriptionTerm.originalEndDate;
				}

				if (instanceSize == null) {
					instanceSize = subscriptionTerm.instanceSize;
				}

				if (now.after(subscriptionTerm.startDate) &&
					now.before(subscriptionTerm.endDate)) {

					quantity += subscriptionTerm.quantity;
				}
			}

			subscriptionTerms.add(subscriptionTerm);
		}

		public JSONArray getSubscriptionTermsJSONArray() {
			JSONArray jsonArray = new JSONArray();

			for (SubscriptionTerm subscriptionTerm : subscriptionTerms) {
				jsonArray.put(subscriptionTerm.toJSONObject());
			}

			return jsonArray;
		}

		public JSONObject toJSONObject() {
			JSONObject jsonObject = new JSONObject();

			jsonObject.put("accountKey", accountKey);
			jsonObject.put(
				"accountSubscriptionGroupERC",
				accountSubscriptionGroupExternalReferenceCode);
			jsonObject.put("endDate", DateUtil.format(originalEndDate));
			jsonObject.put("externalReferenceCode", externalReferenceCode);
			jsonObject.put("instanceSize", instanceSize);
			jsonObject.put("name", name);
			jsonObject.put("productKey", productKey);
			jsonObject.put("quantity", quantity);
			jsonObject.put("startDate", DateUtil.format(startDate));

			Date now = new Date();

			String subscriptionStatus = null;

			if ((endDate != null) && endDate.before(now)) {
				subscriptionStatus = "Expired";
			}
			else if ((startDate != null) && startDate.after(now)) {
				subscriptionStatus = "Future";
			}
			else {
				subscriptionStatus = "Active";
			}

			jsonObject.put("subscriptionStatus", subscriptionStatus);
			jsonObject.put(
				"subscriptionTerms", getSubscriptionTermsJSONArray());

			return jsonObject;
		}

		public String accountKey;
		public String accountSubscriptionGroupExternalReferenceCode;
		public Date endDate;
		public String externalReferenceCode;
		public String instanceSize;
		public String name;
		public Date originalEndDate;
		public String productKey;
		public int quantity;
		public Date startDate;
		public List<SubscriptionTerm> subscriptionTerms = new ArrayList<>();

	}

	private static class SubscriptionGroup {

		public SubscriptionGroup(
				String name, List<JSONObject> productPurchaseJSONObjects,
				String externalLinks)
			throws Exception {

			this.name = name;

			if (name.equals(SubscriptionConstants.GROUP_NAME_ANALYTICS_CLOUD)) {
				String acWorkspaceId = TransformAccount.getACWorkspaceGroupId(
					externalLinks);

				if (!acWorkspaceId.isEmpty()) {
					this.manageContactsURL =
						"https://analytics.liferay.com/workspace/" +
							acWorkspaceId + "/sites";
				}
			}
			else if (name.equals(
						SubscriptionConstants.
							GROUP_NAME_LIFERAY_EXPERIENCE_CLOUD)) {

				String lxcProjectId = TransformAccount.getLXCProjectId(
					externalLinks);

				if (!lxcProjectId.isEmpty()) {
					this.manageContactsURL =
						"https://" + lxcProjectId + ".lxc.liferay.com";
				}
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_LXC_SM)) {
				this.manageContactsURL = "https://console.liferay.cloud";
			}

			for (JSONObject jsonObject : productPurchaseJSONObjects) {
				if (accountKey == null) {
					accountKey = jsonObject.getString("accountKey");

					externalReferenceCode = _getAccountSubscriptionGroupERC(
						accountKey, name);
				}

				JSONObject productJSONObject = jsonObject.getJSONObject(
					"product");

				String productKey = productJSONObject.getString("key");

				JSONObject productPropertiesJSONObject =
					productJSONObject.getJSONObject("properties");

				String subscriptionName = productPropertiesJSONObject.optString(
					"display-name");

				if (subscriptionName.isEmpty()) {
					subscriptionName = productJSONObject.getString("name");
				}

				Subscription subscription = subscriptionsMap.get(productKey);

				if (subscription == null) {
					subscription = new Subscription(
						accountKey, productKey, name, subscriptionName);

					subscriptionsMap.put(productKey, subscription);
				}

				subscription.addSubscriptionTerm(jsonObject);
			}
		}

		public JSONArray getSubscriptionJSONArray() {
			JSONArray jsonArray = new JSONArray();

			for (Subscription subscription : subscriptionsMap.values()) {
				jsonArray.put(subscription.toJSONObject());
			}

			return jsonArray;
		}

		public JSONObject toJSONObject() {
			JSONObject jsonObject = new JSONObject();

			jsonObject.put("accountKey", accountKey);
			jsonObject.put("externalReferenceCode", externalReferenceCode);

			if (name.equals(SubscriptionConstants.GROUP_NAME_ANALYTICS_CLOUD) ||
				name.equals(SubscriptionConstants.GROUP_NAME_COMMERCE) ||
				name.equals(SubscriptionConstants.GROUP_NAME_DXP) ||
				name.equals(
					SubscriptionConstants.GROUP_NAME_ENTERPRISE_SEARCH) ||
				name.equals(SubscriptionConstants.GROUP_NAME_LXC_SM) ||
				name.equals(SubscriptionConstants.GROUP_NAME_PORTAL)) {

				jsonObject.put("hasActivation", true);
			}
			else {
				jsonObject.put("hasActivation", false);
			}

			jsonObject.put("manageContactsURL", manageContactsURL);
			jsonObject.put("menuOrder", _getMenuOrder());
			jsonObject.put("name", name);
			jsonObject.put("subscriptions", getSubscriptionJSONArray());
			jsonObject.put("tabOrder", _getTabOrder());

			return jsonObject;
		}

		public String accountKey;
		public String externalReferenceCode;
		public String manageContactsURL = "";
		public String name;
		public Map<String, Subscription> subscriptionsMap = new HashMap<>();

		private int _getMenuOrder() {
			if (name.equals(SubscriptionConstants.GROUP_NAME_ANALYTICS_CLOUD)) {
				return 400;
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_COMMERCE)) {
				return 500;
			}
			else if (name.equals(
						SubscriptionConstants.GROUP_NAME_COMMERCE_FOR_CLOUD)) {

				return 200;
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_DXP)) {
				return 300;
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_LXC_SM)) {
				return 100;
			}
			else if (name.equals(
						SubscriptionConstants.GROUP_NAME_ENTERPRISE_SEARCH)) {

				return 600;
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_PORTAL)) {
				return 700;
			}

			return 100000;
		}

		private int _getTabOrder() {
			if (name.equals(SubscriptionConstants.GROUP_NAME_ANALYTICS_CLOUD)) {
				return 600;
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_COMMERCE)) {
				return 700;
			}
			else if (name.equals(
						SubscriptionConstants.GROUP_NAME_COMMERCE_FOR_CLOUD)) {

				return 400;
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_DXP)) {
				return 500;
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_LXC_SM)) {
				return 300;
			}
			else if (name.equals(
						SubscriptionConstants.GROUP_NAME_ENTERPRISE_SEARCH)) {

				return 800;
			}
			else if (name.equals(
						SubscriptionConstants.
							GROUP_NAME_LIFERAY_EXPERIENCE_CLOUD)) {

				return 200;
			}
			else if (name.equals(SubscriptionConstants.GROUP_NAME_PORTAL)) {
				return 900;
			}
			else if (name.equals(
						SubscriptionConstants.GROUP_NAME_PARTNERSHIP)) {

				return 100;
			}

			return 100000;
		}

	}

	private static class SubscriptionTerm {

		public SubscriptionTerm(
				String accountSubscriptionGroupExternalReferenceCode,
				String accountSubscriptionExternalReferenceCode,
				JSONObject jsonObject)
			throws Exception {

			this.accountSubscriptionGroupExternalReferenceCode =
				accountSubscriptionGroupExternalReferenceCode;
			this.accountSubscriptionExternalReferenceCode =
				accountSubscriptionExternalReferenceCode;

			accountKey = jsonObject.getString("accountKey");
			endDate = DateUtil.parseEndDate(jsonObject);
			externalReferenceCode = jsonObject.getString("key");

			JSONObject propertiesJSONObject = jsonObject.getJSONObject(
				"properties");

			instanceSize = propertiesJSONObject.optString("sizing");

			originalEndDate = DateUtil.parseOriginalEndDate(jsonObject);

			JSONArray jsonArray = jsonObject.getJSONArray(
				"productConsumptions");

			provisioned = jsonArray.length();

			quantity = jsonObject.getInt("quantity");
			startDate = DateUtil.parseStartDate(jsonObject);
			status = jsonObject.getString("status");
		}

		public JSONObject toJSONObject() {
			JSONObject jsonObject = new JSONObject();

			jsonObject.put("accountKey", accountKey);
			jsonObject.put(
				"accountSubscriptionERC",
				accountSubscriptionExternalReferenceCode);
			jsonObject.put(
				"accountSubscriptionGroupERC",
				accountSubscriptionGroupExternalReferenceCode);
			jsonObject.put("endDate", DateUtil.format(originalEndDate));
			jsonObject.put("externalReferenceCode", externalReferenceCode);
			jsonObject.put("instanceSize", instanceSize);
			jsonObject.put("provisioned", provisioned);
			jsonObject.put("quantity", quantity);
			jsonObject.put("startDate", DateUtil.format(startDate));

			Date now = new Date();

			String subscriptionTermStatus = null;

			if ((endDate != null) && endDate.before(now)) {
				subscriptionTermStatus = "Expired";
			}
			else if ((startDate != null) && startDate.after(now)) {
				subscriptionTermStatus = "Future";
			}
			else {
				subscriptionTermStatus = "Active";
			}

			jsonObject.put("subscriptionTermStatus", subscriptionTermStatus);

			return jsonObject;
		}

		public String accountKey;
		public String accountSubscriptionExternalReferenceCode;
		public String accountSubscriptionGroupExternalReferenceCode;
		public Date endDate;
		public String externalReferenceCode;
		public String instanceSize;
		public Date originalEndDate;
		public int provisioned;
		public int quantity;
		public Date startDate;
		public String status;

	}

}