    <elementParameter field="MEMO_JAVA" name="CODE" value="JSONArray customerContactsJSONArray = (JSONArray)globalMap.get(&quot;customerContactsJSONArray&quot;);&#xA;List&lt;String> removeEmailAddresses = (List&lt;String>)globalMap.get(&quot;removeEmailAddresses&quot;);&#xA;List&lt;Map&lt;String, String>> updateUsers = (List&lt;Map&lt;String, String>>)globalMap.get(&quot;updateUsers&quot;);&#xA;List&lt;Map&lt;String, String>> userContactRoles = (List&lt;Map&lt;String, String>>)globalMap.get(&quot;userContactRoles&quot;);&#xA;&#xA;boolean isCustomer = false;&#xA;int index = 0;&#xA;&#xA;for (int i = 0; i &lt; customerContactsJSONArray.length(); i++) {&#xA;&#x9;JSONObject jsonObject = customerContactsJSONArray.getJSONObject(i);&#xA;&#xA;&#x9;String curEmailAddress = jsonObject.getString(&quot;emailAddress&quot;);&#xA;&#xA;&#x9;if (curEmailAddress.equalsIgnoreCase(row1.emailAddress)) {&#xA;&#x9;&#x9;isCustomer = true;&#xA;&#x9;&#x9;index = i;&#xA;&#xA;&#x9;&#x9;String firstName = jsonObject.getString(&quot;firstName&quot;);&#xA;&#x9;&#x9;String lastName = jsonObject.getString(&quot;lastName&quot;);&#xA;&#xA;&#x9;&#x9;JSONArray curPhonesJSONArray = new JSONArray();&#xA;&#xA;&#x9;&#x9;if ((row1.userAccountContactInformation_telephones != null) &amp;&amp;&#xA;&#x9;&#x9;&#x9;(row1.userAccountContactInformation_telephones != &quot;&quot;)) {&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;curPhonesJSONArray = new JSONArray(row1.userAccountContactInformation_telephones);&#xA;&#x9;&#x9;}&#xA;&#xA;&#x9;&#x9;JSONArray phonesJSONArray = ContactRoleParser.getPhonesJSONArray(curPhonesJSONArray, jsonObject);&#xA;&#xA;&#x9;&#x9;if (!firstName.equals(row1.givenName) || !lastName.equals(row1.familyName) ||&#xA;&#x9;&#x9;&#x9;!(curPhonesJSONArray.toString().equals(phonesJSONArray.toString()))) {&#xA;&#xA;&#x9;&#x9;&#x9;Map&lt;String, String> userFields = new HashMap&lt;String, String>();&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;userFields.put(&quot;alternateName&quot;, row1.alternateName);&#xA;&#x9;&#x9;&#x9;userFields.put(&quot;emailAddress&quot;, row1.emailAddress);&#xA;&#x9;&#x9;&#x9;userFields.put(&quot;familyName&quot;, lastName);&#xA;&#x9;&#x9;&#x9;userFields.put(&quot;givenName&quot;, firstName);&#xA;&#x9;&#x9;&#x9;userFields.put(&quot;id&quot;, String.valueOf(row1.id));&#xA;&#xA;&#x9;&#x9;&#x9;JSONObject userAccountContactInformationJSONObject = new JSONObject();&#xA;&#xA;&#x9;&#x9;&#x9;userAccountContactInformationJSONObject.put(&quot;telephones&quot;, phonesJSONArray);&#xA;&#xA;&#x9;&#x9;&#x9;userFields.put(&quot;userAccountContactInformation&quot;, userAccountContactInformationJSONObject.toString());&#xA;&#xA;&#x9;&#x9;&#x9;updateUsers.add(userFields);&#xA;&#x9;&#x9;}&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;Map&lt;String, String> userContactRoleMap = new HashMap&lt;String, String>();&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;userContactRoleMap.put(&quot;emailAddress&quot;, row1.emailAddress);&#xA;&#x9;&#x9;userContactRoleMap.put(&quot;contactRoles&quot;, jsonObject.getString(&quot;contactRoles&quot;));&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;userContactRoles.add(userContactRoleMap);&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;break;&#xA;&#x9;}&#xA;}&#xA;&#xA;if (isCustomer) {&#xA;&#x9;customerContactsJSONArray.remove(index);&#xA;}&#xA;else {&#xA;&#x9;removeEmailAddresses.add(row1.emailAddress);&#xA;}"/>
