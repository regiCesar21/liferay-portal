    <elementParameter field="MEMO_JAVA" name="CODE" value="System.out.println(&quot;Start account sync job&quot;);&#xA;System.out.println(&quot;Syncing to &quot; + context.customerPortalHost + &quot; using &quot; + &#xA;context.customerPortalUserName);&#xA;&#xA;context.lastRunStartDate = DateUtil.getLastRunStartDate(context.lastRunStartDate, context.deltaMins);&#xA;&#xA;if ((context.accountSyncFilter == null) || context.accountSyncFilter.equals(&quot;&quot;)) {&#xA;&#x9;context.accountSyncFilter = &quot;entitlements/any(s:contains(s, 'Subscription') or s eq 'Partner') and dateModified gt &quot; + context.lastRunStartDate;&#xA;}&#xA;&#xA;// Test&#xA;//context.accountSyncFilter = &quot;code eq 'AMOS'&quot;;&#xA;//context.accountSyncFilter = &quot;entitlements/any(s:contains(s, 'Subscription') or s eq 'Partner') and (code eq 'FIFAWCQATAR' or code eq 'NINTENDOJPOSBT' or code eq 'TECHLTD2' or code eq 'TECHVISION' or code eq 'NATIONNASAIC')&quot;;&#xA;//context.accountSyncFilter = &quot;entitlements/any(s:contains(s, 'Subscription') or s eq 'Partner') and dateModified gt 2021-06-22T01:20:20Z&quot;;&#xA;//context.accountSyncFilter = &quot;entitlements/any(s:contains(s, 'Subscription') or s eq 'Partner') and (code eq  'BRCMANALYTICS')&quot;;&#xA;&#xA;System.out.println(&quot;Syncing accounts with filter: &quot; + context.accountSyncFilter);"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="import java.util.Date;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
