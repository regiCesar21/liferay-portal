package routines;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;

import routines.system.JSONArray;
import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class ContactRoleParser {

	public static JSONArray filterContactRoles(
		JSONArray contactRolesJSONArray) {

		JSONArray newJSONArray = new JSONArray();

		for (int i = 0; i < contactRolesJSONArray.length(); i++) {
			JSONObject jsonObject = contactRolesJSONArray.getJSONObject(i);

			String name = jsonObject.getString("name");

			if (name.equals(
					ContactRoleConstants.NAME_ADMINISTRATOR_PROVISIONING) ||
				name.equals(
					ContactRoleConstants.
						NAME_LIFERAY_CUSTOMER_SUCCESS_PROVISIONING) ||
				name.equals(
					ContactRoleConstants.
						NAME_CRITICAL_INCIDENT_CONTACT_PROVISIONING) ||
				name.equals(
					ContactRoleConstants.
						NAME_DATA_BREACH_CONTACT_PROVISIONING) ||
				name.equals(
					ContactRoleConstants.NAME_LIFERAY_SALES_PROVISIONING) ||
				name.equals(ContactRoleConstants.NAME_MEMBER_PROVISIONING) ||
				name.equals(
					ContactRoleConstants.NAME_PARTNER_MANAGER_PROVISIONING) ||
				name.equals(
					ContactRoleConstants.NAME_PARTNER_MEMBER_PROVISIONING) ||
				name.equals(ContactRoleConstants.NAME_REQUESTER_PROVISIONING) ||
				name.equals(
					ContactRoleConstants.
						NAME_SECURITY_INCIDENT_CONTACT_PROVISIONING)) {

				newJSONArray.put(jsonObject);
			}
		}

		return newJSONArray;
	}

	public static String getAccountRoleId(
		Map<String, String> accountRoleIdMap, String contactRoleName) {

		if ((contactRoleName == null) || contactRoleName.isEmpty()) {
			return "";
		}

		if (contactRoleName.equals(
				ContactRoleConstants.NAME_ADMINISTRATOR_PROVISIONING)) {

			return accountRoleIdMap.get(
				ContactRoleConstants.NAME_ADMINISTRATOR_CP);
		}
		else if (contactRoleName.equals(
					ContactRoleConstants.
						NAME_CRITICAL_INCIDENT_CONTACT_PROVISIONING)) {

			return accountRoleIdMap.get(
				ContactRoleConstants.NAME_CRITICAL_INCIDENT_CONTACT_CP);
		}
		else if (contactRoleName.equals(
					ContactRoleConstants.
						NAME_DATA_BREACH_CONTACT_PROVISIONING)) {

			return accountRoleIdMap.get(
				ContactRoleConstants.NAME_DATA_BREACH_CONTACT_CP);
		}
		else if (contactRoleName.equals(
					ContactRoleConstants.
						NAME_LIFERAY_CUSTOMER_SUCCESS_PROVISIONING) ||
				 contactRoleName.equals(
					 ContactRoleConstants.NAME_LIFERAY_SALES_PROVISIONING)) {

			return accountRoleIdMap.get(
				ContactRoleConstants.NAME_PROVISIONING_CP);
		}
		else if (contactRoleName.equals(
					ContactRoleConstants.NAME_MEMBER_PROVISIONING)) {

			return accountRoleIdMap.get(ContactRoleConstants.NAME_MEMBER_CP);
		}
		else if (contactRoleName.equals(
					ContactRoleConstants.NAME_PARTNER_MANAGER_PROVISIONING)) {

			return accountRoleIdMap.get(
				ContactRoleConstants.NAME_PARTNER_MANAGER_CP);
		}
		else if (contactRoleName.equals(
					ContactRoleConstants.NAME_PARTNER_MEMBER_PROVISIONING)) {

			return accountRoleIdMap.get(
				ContactRoleConstants.NAME_PARTNER_MEMBER_CP);
		}
		else if (contactRoleName.equals(
					ContactRoleConstants.NAME_REQUESTER_PROVISIONING)) {

			return accountRoleIdMap.get(ContactRoleConstants.NAME_REQUESTER_CP);
		}
		else if (contactRoleName.equals(
					ContactRoleConstants.
						NAME_SECURITY_INCIDENT_CONTACT_PROVISIONING)) {

			return accountRoleIdMap.get(
				ContactRoleConstants.NAME_SECURITY_INCIDENT_CONTACT_CP);
		}

		return "";
	}

	public static List<String> getAccountRoleIdList(
		Map<String, String> accountRoleMap, String contactRoles) {

		List<String> accountRoleIdList = new ArrayList<>();

		JSONArray jsonArray = new JSONArray(contactRoles);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			String contactRoleName = jsonObject.getString("name");

			String accountRoleId = getAccountRoleId(
				accountRoleMap, contactRoleName);

			if ((accountRoleId != null) && !accountRoleId.equals("")) {
				accountRoleIdList.add(accountRoleId);
			}
		}

		return accountRoleIdList;
	}

	public static JSONArray getPhonesJSONArray(
		JSONArray curPhonesJSONArray, JSONObject userJSONObject) {

		if (curPhonesJSONArray == null) {
			curPhonesJSONArray = new JSONArray();
		}

		JSONArray newPhonesJSONArray = new JSONArray();

		if (!userJSONObject.has("phones")) {
			return newPhonesJSONArray;
		}

		JSONArray phonesJSONArray = userJSONObject.getJSONArray("phones");

		for (int j = 0; j < phonesJSONArray.length(); j++) {
			JSONObject phoneJSONObject = phonesJSONArray.getJSONObject(j);

			String type = phoneJSONObject.optString("type");
			boolean primary = phoneJSONObject.optBoolean("primary");

			boolean updated = false;

			for (int k = 0; k < curPhonesJSONArray.length(); k++) {
				JSONObject curPhoneJSONObject =
					curPhonesJSONArray.getJSONObject(k);

				String curType = curPhoneJSONObject.optString("phoneType");
				boolean curPrimary = curPhoneJSONObject.optBoolean("primary");

				if ((type.equals("Mobile") && curType.equals("mobile-phone")) ||
					(type.equals("Other") && curType.equals("other") &&
					 primary && curPrimary)) {

					JSONObject newPhoneJSONObject = new JSONObject(
						curPhoneJSONObject.toString());

					newPhoneJSONObject.put(
						"phoneNumber", phoneJSONObject.getString("number"));

					newPhonesJSONArray.put(newPhoneJSONObject);

					updated = true;

					break;
				}
			}

			if (!updated) {
				JSONObject curJSONObject = new JSONObject();

				curJSONObject.put(
					"phoneNumber", phoneJSONObject.getString("number"));

				if (type.equals("Mobile")) {
					curJSONObject.put("phoneType", "mobile-phone");
				}
				else {
					curJSONObject.put("phoneType", "other");
				}

				curJSONObject.put("primary", primary);

				newPhonesJSONArray.put(curJSONObject);
			}
		}

		return newPhonesJSONArray;
	}

	public static void setAccountRoleId(
		Map<String, String> accountRoleIdMap, String contactRoleName,
		long accountRoleId) {

		if (contactRoleName.equals(
				ContactRoleConstants.NAME_ADMINISTRATOR_CP) ||
			contactRoleName.equals(
				ContactRoleConstants.NAME_CRITICAL_INCIDENT_CONTACT_CP) ||
			contactRoleName.equals(
				ContactRoleConstants.NAME_DATA_BREACH_CONTACT_CP) ||
			contactRoleName.equals(ContactRoleConstants.NAME_MEMBER_CP) ||
			contactRoleName.equals(
				ContactRoleConstants.NAME_PARTNER_MANAGER_CP) ||
			contactRoleName.equals(
				ContactRoleConstants.NAME_PARTNER_MEMBER_CP) ||
			contactRoleName.equals(ContactRoleConstants.NAME_PROVISIONING_CP) ||
			contactRoleName.equals(ContactRoleConstants.NAME_REQUESTER_CP) ||
			contactRoleName.equals(
				ContactRoleConstants.NAME_SECURITY_INCIDENT_CONTACT_CP)) {

			accountRoleIdMap.put(
				contactRoleName, String.valueOf(accountRoleId));
		}
	}

}