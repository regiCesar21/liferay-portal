public class TransformAccount {

	public static final String CONTACT_ROLE_NAME_PRIMARY = "Primary Contact";

	public static final String CONTACT_ROLE_NAME_SECONDARY =
		"Secondary Contact";

	public static String getACWorkspaceGroupId(String externalLinks) {
		JSONArray jsonArray = new JSONArray(externalLinks);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			String domain = jsonObject.getString("domain");
			String entityName = jsonObject.getString("entityName");

			if (domain.equals(Constants.EXTERNAL_LINK_DOMAIN_AC) &&
				entityName.equals(
					Constants.EXTERNAL_LINK_ENTITY_NAME_AC_GROUP)) {

				return jsonObject.getString("entityId");
			}
		}

		return "";
	}

	public static boolean getAllowSelfProvisioning(String properties) {
		JSONObject jsonObject = new JSONObject(properties);

		if (jsonObject.has("allowSelfProvisioning")) {
			boolean allowSelfProvisioning = jsonObject.getBoolean(
				"allowSelfProvisioning");

			return allowSelfProvisioning;
		}

		return true;
	}

	public static String getCombinedContactsJSONArray(
		String customerContacts, String workerContacts) {

		JSONArray customerContactsJSONArray = new JSONArray(customerContacts);
		JSONArray workerContactsJSONArray = new JSONArray(workerContacts);

		Map<String, JSONObject> contactsMap = new HashMap<>();

		for (int i = 0; i < customerContactsJSONArray.length(); i++) {
			JSONObject jsonObject = customerContactsJSONArray.getJSONObject(i);

			JSONArray contactRolesJSONArray =
				ContactRoleParser.filterContactRoles(
					jsonObject.getJSONArray("contactRoles"));

			if (contactRolesJSONArray.length() > 0) {
				jsonObject.put("contactRoles", contactRolesJSONArray);

				contactsMap.put(
					jsonObject.getString("emailAddress"), jsonObject);
			}
		}

		for (int i = 0; i < workerContactsJSONArray.length(); i++) {
			JSONObject jsonObject = workerContactsJSONArray.getJSONObject(i);

			JSONArray contactRolesJSONArray =
				ContactRoleParser.filterContactRoles(
					jsonObject.getJSONArray("contactRoles"));

			if (contactRolesJSONArray.length() <= 0) {
				continue;
			}

			JSONObject curJSONObject = contactsMap.get(
				jsonObject.getString("emailAddress"));

			if (curJSONObject == null) {
				jsonObject.put("contactRoles", contactRolesJSONArray);

				contactsMap.put(
					jsonObject.getString("emailAddress"), jsonObject);
			}
			else {
				JSONArray curContactRolesJSONArray = curJSONObject.getJSONArray(
					"contactRoles");

				for (int j = 0; j < contactRolesJSONArray.length(); j++) {
					JSONObject contactRoleJSONObject =
						contactRolesJSONArray.getJSONObject(j);

					curContactRolesJSONArray.put(contactRoleJSONObject);
				}
			}
		}

		JSONArray jsonArray = new JSONArray();

		for (JSONObject jsonObject : contactsMap.values()) {
			jsonArray.put(jsonObject);
		}

		return jsonArray.toString();
	}

	public static String getLiferayContactEmailAddress(
		String region, String workerContacts) {

		String primaryContactEmailAddress = null;
		String secondaryContactEmailAddress = null;

		if ((workerContacts != null) && !workerContacts.isEmpty()) {
			JSONArray jsonArray = new JSONArray(workerContacts);

			for (int i = 0; i < jsonArray.length(); i++) {
				JSONObject jsonObject = jsonArray.getJSONObject(i);

				JSONArray contactRolesJSONArray = jsonObject.getJSONArray(
					"contactRoles");

				for (int j = 0; j < contactRolesJSONArray.length(); j++) {
					JSONObject contactRoleJSONObject =
						contactRolesJSONArray.getJSONObject(j);

					String contactRoleName = contactRoleJSONObject.getString(
						"name");

					if (contactRoleName.equals(CONTACT_ROLE_NAME_PRIMARY)) {
						primaryContactEmailAddress = jsonObject.getString(
							"emailAddress");

						break;
					}
					else if (contactRoleName.equals(
								CONTACT_ROLE_NAME_SECONDARY)) {

						secondaryContactEmailAddress = jsonObject.getString(
							"emailAddress");

						break;
					}
				}
			}
		}

		if ((primaryContactEmailAddress != null) &&
			!primaryContactEmailAddress.isEmpty()) {

			return primaryContactEmailAddress;
		}

		if ((secondaryContactEmailAddress != null) &&
			!secondaryContactEmailAddress.isEmpty()) {

			return secondaryContactEmailAddress;
		}

		return "customer-service@liferay.com";
	}

	public static String getLiferayContactName(
		String region, String workerContacts) {

		String primaryContactName = null;
		String secondaryContactName = null;

		if ((workerContacts != null) && !workerContacts.isEmpty()) {
			JSONArray jsonArray = new JSONArray(workerContacts);

			for (int i = 0; i < jsonArray.length(); i++) {
				JSONObject jsonObject = jsonArray.getJSONObject(i);

				JSONArray contactRolesJSONArray = jsonObject.getJSONArray(
					"contactRoles");

				for (int j = 0; j < contactRolesJSONArray.length(); j++) {
					JSONObject contactRoleJSONObject =
						contactRolesJSONArray.getJSONObject(j);

					String contactRoleName = contactRoleJSONObject.getString(
						"name");

					if (contactRoleName.equals(CONTACT_ROLE_NAME_PRIMARY)) {
						primaryContactName =
							jsonObject.getString("firstName") + " " +
								jsonObject.getString("lastName");

						break;
					}
					else if (contactRoleName.equals(
								CONTACT_ROLE_NAME_SECONDARY)) {

						secondaryContactName =
							jsonObject.getString("firstName") + " " +
								jsonObject.getString("lastName");

						break;
					}
				}
			}
		}

		if ((primaryContactName != null) && !primaryContactName.isEmpty()) {
			return primaryContactName;
		}

		if ((secondaryContactName != null) && !secondaryContactName.isEmpty()) {
			return secondaryContactName;
		}

		return "Liferay Support";
	}

	public static String getLiferayContactRole(
		String region, String workerContacts) {

		String primaryContactRole = null;
		String secondaryContactRole = null;

		if ((workerContacts != null) && !workerContacts.isEmpty()) {
			JSONArray jsonArray = new JSONArray(workerContacts);

			for (int i = 0; i < jsonArray.length(); i++) {
				JSONObject jsonObject = jsonArray.getJSONObject(i);

				JSONArray contactRolesJSONArray = jsonObject.getJSONArray(
					"contactRoles");

				boolean primaryContact = false;
				boolean secondaryContact = false;
				Set<String> contactRoleNames = new TreeSet<>();

				for (int j = 0; j < contactRolesJSONArray.length(); j++) {
					JSONObject contactRoleJSONObject =
						contactRolesJSONArray.getJSONObject(j);

					String contactRoleName = contactRoleJSONObject.getString(
						"name");

					if (contactRoleName.equals(CONTACT_ROLE_NAME_PRIMARY)) {
						primaryContact = true;
					}
					else if (contactRoleName.equals(
								CONTACT_ROLE_NAME_SECONDARY)) {

						secondaryContact = true;
					}
					else {
						contactRoleNames.add(contactRoleName);
					}
				}

				if (primaryContact) {
					primaryContactRole = String.join(", ", contactRoleNames);
				}
				else if (secondaryContact) {
					secondaryContactRole = String.join(", ", contactRoleNames);
				}
			}
		}

		if ((primaryContactRole != null) && !primaryContactRole.isEmpty()) {
			return primaryContactRole;
		}

		if ((secondaryContactRole != null) && !secondaryContactRole.isEmpty()) {
			return secondaryContactRole;
		}

		return "";
	}

	public static String getLiferayVersion(String properties) throws Exception {
		JSONObject jsonObject = new JSONObject(properties);

		if (jsonObject.has("liferayVersion")) {
			String liferayVersion = jsonObject.getString("liferayVersion");

			if (liferayVersion.startsWith("DXP ")) {
				return liferayVersion.substring(4);
			}
		}

		return "";
	}

	public static String getLXCProjectId(String externalLinks) {
		JSONArray jsonArray = new JSONArray(externalLinks);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			String domain = jsonObject.getString("domain");
			String entityName = jsonObject.getString("entityName");

			if (domain.equals(Constants.EXTERNAL_LINK_DOMAIN_LXC) &&
				entityName.equals(
					Constants.EXTERNAL_LINK_ENTITY_NAME_LXC_PROJECT)) {

				return jsonObject.getString("entityId");
			}
		}

		return "";
	}

	public static int getMaxRequestors(String productPurchases)
		throws Exception {

		String name = getSLACurrent(productPurchases);

		if (name.isEmpty()) {
			return 0;
		}

		boolean analyticsCloud = false;
		boolean managedServices = false;
		int supportSeatAddons = 0;
		int productionInstances = 0;
		int maxSupportSeatCount = 0;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			Date startDate = DateUtil.parseStartDate(jsonObject);
			Date endDate = DateUtil.parseEndDate(jsonObject);
			String status = jsonObject.getString("status");

			if (!_isActive(startDate, endDate, status)) {
				continue;
			}

			int quantity = jsonObject.getInt("quantity");

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			String curName = productJSONObject.getString("name");

			if (curName.equals(ProductConstants.NAME_ANALYTICS_CLOUD_BASIC) ||
				curName.equals(
					ProductConstants.NAME_ANALYTICS_CLOUD_BUSINESS) ||
				curName.equals(
					ProductConstants.NAME_ANALYTICS_CLOUD_ENTERPRISE)) {

				analyticsCloud = true;
			}

			if (curName.equals(
					ProductConstants.NAME_DESIGNATED_CONTACT_ADD_ON)) {

				supportSeatAddons += quantity;
			}
			else if (curName.equals(ProductConstants.NAME_MANAGED_SERVICES) ||
					 curName.equals(
						 ProductConstants.NAME_MANAGED_SERVICES_DXP) ||
					 curName.equals(
						 ProductConstants.NAME_MANAGED_SERVICES_LXC_SM)) {

				managedServices = true;
			}
			else if (curName.equals(
						ProductConstants.
							NAME_DXP_CLOUD_SUBSCRIPTION_HA_PRODUCTION) ||
					 curName.equals(
						 ProductConstants.
							 NAME_LXC_SM_SUBSCRIPTION_HA_PRODUCTION)) {

				productionInstances += 2 * quantity;
			}
			else if (curName.equals(ProductConstants.NAME_DXP_PRODUCTION) ||
					 curName.equals(
						 ProductConstants.NAME_DXP_CLOUD_INSTANCE_PRODUCTION) ||
					 curName.equals(
						 ProductConstants.
							 NAME_DXP_CLOUD_SUBSCRIPTION_STD_PRODUCTION) ||
					 curName.equals(ProductConstants.NAME_DXP_FLEX) ||
					 curName.equals(ProductConstants.NAME_DXP_OEM) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_CSP_CUSTOM_USER_TIER) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_CSP_UP_TO_1K_USERS) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_CSP_UP_TO_5K_USERS) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_CSP_UP_TO_10K_USERS) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_CSP_UP_TO_20K_USERS) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_CSP_UP_TO_100_USERS) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_CSP_UP_TO_500_USERS) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_SM_INSTANCE_PRODUCTION) ||
					 curName.equals(
						 ProductConstants.
							 NAME_LXC_SM_SUBSCRIPTION_STD_PRODUCTION) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_SUBSCRIPTION_ENGAGE_SITE) ||
					 curName.equals(
						 ProductConstants.NAME_LXC_SUBSCRIPTION_SUPPORT_SITE) ||
					 curName.equals(
						 ProductConstants.
							 NAME_LXC_SUBSCRIPTION_TRANSACT_SITE) ||
					 curName.equals(ProductConstants.NAME_PORTAL_OEM) ||
					 curName.equals(ProductConstants.NAME_PORTAL_PRODUCTION)) {

				productionInstances += quantity;
			}
			else if (curName.equals(ProductConstants.NAME_LXC_PRO_PLAN)) {
				maxSupportSeatCount = 2;
			}
			else if (curName.equals(ProductConstants.NAME_LXC_BUSINESS_PLAN)) {
				maxSupportSeatCount = 15;
			}
			else if (curName.equals(
						ProductConstants.NAME_LXC_ENTERPRISE_PLAN)) {

				maxSupportSeatCount = 18;
			}
		}

		if (managedServices) {
			return 10 + supportSeatAddons;
		}

		maxSupportSeatCount += supportSeatAddons;

		if (productionInstances <= 0) {
			if (analyticsCloud) {
				return -1;
			}

			return maxSupportSeatCount;
		}

		if (name.equals(ProductConstants.NAME_GOLD)) {
			if (productionInstances <= 4) {
				maxSupportSeatCount += 2;
			}
			else if (productionInstances <= 8) {
				maxSupportSeatCount += 4;
			}
			else if (productionInstances <= 12) {
				maxSupportSeatCount += 6;
			}
			else if (productionInstances <= 16) {
				maxSupportSeatCount += 8;
			}
			else if (productionInstances <= 20) {
				maxSupportSeatCount += 10;
			}
			else {
				maxSupportSeatCount += 12;
			}
		}
		else if (name.equals(ProductConstants.NAME_PLATINUM)) {
			if (productionInstances <= 4) {
				maxSupportSeatCount += 3;
			}
			else if (productionInstances <= 8) {
				maxSupportSeatCount += 6;
			}
			else if (productionInstances <= 12) {
				maxSupportSeatCount += 9;
			}
			else if (productionInstances <= 16) {
				maxSupportSeatCount += 12;
			}
			else if (productionInstances <= 20) {
				maxSupportSeatCount += 15;
			}
			else {
				maxSupportSeatCount += 18;
			}
		}
		else if (name.equals(ProductConstants.NAME_PREMIUM)) {
			if (productionInstances <= 3) {
				maxSupportSeatCount += 3;
			}
			else if (productionInstances <= 6) {
				maxSupportSeatCount += 6;
			}
			else if (productionInstances <= 9) {
				maxSupportSeatCount += 9;
			}
			else if (productionInstances <= 12) {
				maxSupportSeatCount += 12;
			}
			else if (productionInstances <= 15) {
				maxSupportSeatCount += 15;
			}
			else {
				maxSupportSeatCount += 18;
			}
		}

		return maxSupportSeatCount;
	}

	public static String getSLACurrent(String productPurchases)
		throws Exception {

		JSONObject slaJSONObject = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			if (!_isSLAProduct(jsonObject)) {
				continue;
			}

			Date startDate = DateUtil.parseStartDate(jsonObject);
			Date endDate = DateUtil.parseEndDate(jsonObject);
			String status = jsonObject.getString("status");

			if (!_isActive(startDate, endDate, status)) {
				continue;
			}

			if (_isHigherSLA(slaJSONObject, jsonObject)) {
				slaJSONObject = jsonObject;
			}
		}

		if (slaJSONObject != null) {
			JSONObject productJSONObject = slaJSONObject.getJSONObject(
				"product");

			return productJSONObject.getString("name");
		}

		return "";
	}

	public static String getSLACurrentEndDate(String productPurchases)
		throws Exception {

		String slaCurrent = getSLACurrent(productPurchases);

		Date slaCurrentEndDate = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			if (!slaCurrent.equals(productJSONObject.getString("name"))) {
				continue;
			}

			String status = jsonObject.getString("status");

			if (!_isActive(status)) {
				continue;
			}

			Date originalEndDate = DateUtil.parseOriginalEndDate(jsonObject);

			if ((slaCurrentEndDate == null) ||
				slaCurrentEndDate.before(originalEndDate)) {

				slaCurrentEndDate = originalEndDate;
			}
		}

		return DateUtil.format(slaCurrentEndDate);
	}

	public static String getSLACurrentStartDate(String productPurchases)
		throws Exception {

		String slaCurrent = getSLACurrent(productPurchases);

		Date slaCurrentStartDate = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			if (!slaCurrent.equals(productJSONObject.getString("name"))) {
				continue;
			}

			String status = jsonObject.getString("status");

			if (!_isActive(status)) {
				continue;
			}

			Date startDate = DateUtil.parseStartDate(jsonObject);

			if ((slaCurrentStartDate == null) ||
				slaCurrentStartDate.after(startDate)) {

				slaCurrentStartDate = startDate;
			}
		}

		return DateUtil.format(slaCurrentStartDate);
	}

	public static String getSLAExpired(String productPurchases)
		throws Exception {

		String slaCurrent = getSLACurrent(productPurchases);

		if (!slaCurrent.isEmpty()) {
			return "";
		}

		JSONObject slaJSONObject = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			if (!_isSLAProduct(jsonObject)) {
				continue;
			}

			Date startDate = DateUtil.parseStartDate(jsonObject);
			String status = jsonObject.getString("status");

			if (!_isActive(status) || _isActiveFuture(startDate, status)) {
				continue;
			}

			if (_isHigherSLA(slaJSONObject, jsonObject)) {
				slaJSONObject = jsonObject;
			}
		}

		if (slaJSONObject != null) {
			JSONObject productJSONObject = slaJSONObject.getJSONObject(
				"product");

			return productJSONObject.getString("name");
		}

		return "";
	}

	public static String getSLAExpiredEndDate(String productPurchases)
		throws Exception {

		String slaExpired = getSLAExpired(productPurchases);

		Date slaExpiredEndDate = null;

		JSONArray jsonArray = new JSONArray(productPurchases);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			JSONObject productJSONObject = jsonObject.getJSONObject("product");

			if (!slaExpired.equals(productJSONObject.getString("name"))) {
				continue;
			}

			String status = jsonObject.getString("status");

			if (!_isActive(status)) {
				continue;
			}

			Date originalEndDate = DateUtil.parseOriginalEndDate(jsonObject);

			if ((slaExpiredEndDate == null) ||
				slaExpiredEndDate.before(originalEndDate)) {

				slaExpiredEndDate = originalEndDate;
			}
		}

		return DateUtil.format(slaExpiredEndDate);
	}

