	public static boolean isPartner(String entitlements) {
		JSONArray jsonArray = new JSONArray(entitlements);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			String name = jsonObject.getString("name");

			if (name.equals(Constants.ENTITLEMENT_PARTNER)) {
				return true;
			}
		}

		return false;
	}

	private static boolean _contains(String[] array, String value) {
		for (String s : array) {
			if (s.equals(value)) {
				return true;
			}
		}

		return false;
	}

	private static int _getSLARank(JSONObject productJSONObject)
		throws Exception {

		String productName = productJSONObject.getString("name");

		if (productName.equals(ProductConstants.NAME_GOLD)) {
			return 3;
		}
		else if (productName.equals(ProductConstants.NAME_LIMITED)) {
			return 1;
		}
		else if (productName.equals(ProductConstants.NAME_PLATINUM)) {
			return 4;
		}
		else if (productName.equals(ProductConstants.NAME_PREMIUM)) {
			return 5;
		}
		else if (productName.equals(ProductConstants.NAME_SILVER)) {
			return 2;
		}

		return 0;
	}

	private static boolean _isActive(
			Date startDate, Date endDate, String status)
		throws Exception {

		if (!_isActive(status)) {
			return false;
		}

		Date now = new Date();

		if ((startDate != null) && now.before(startDate)) {
			return false;
		}

		if ((endDate != null) && now.after(endDate)) {
			return false;
		}

		return true;
	}

	private static boolean _isActive(String status) throws Exception {
		if ((status == null) ||
			status.equals(ProductConstants.PURCHASE_STATUS_CANCELLED)) {

			return false;
		}

		return true;
	}

	private static boolean _isActiveFuture(Date startDate, String status)
		throws Exception {

		if (!_isActive(status)) {
			return false;
		}

		Date now = new Date();

		if ((startDate != null) && now.before(startDate)) {
			return true;
		}

		return false;
	}

	private static boolean _isHigherSLA(
			JSONObject curJSONObject, JSONObject jsonObject)
		throws Exception {

		if (curJSONObject == null) {
			return true;
		}

		int curSLARank = _getSLARank(jsonObject.getJSONObject("product"));
		int slaRank = _getSLARank(jsonObject.getJSONObject("product"));

		if (slaRank > curSLARank) {
			return true;
		}

		if (slaRank < curSLARank) {
			return false;
		}

		if (curJSONObject.getBoolean("perpetual") &&
			!jsonObject.getBoolean("perpetual")) {

			return true;
		}

		if (curJSONObject.getBoolean("perpetual")) {
			return false;
		}

		Date curEndDate = DateUtil.parseEndDate(curJSONObject);
		Date endDate = DateUtil.parseStartDate(curJSONObject);

		if (endDate.after(curEndDate)) {
			return true;
		}

		return false;
	}

	private static boolean _isSLAProduct(JSONObject jsonObject) {
		JSONObject productJSONObject = jsonObject.getJSONObject("product");

		String productName = productJSONObject.getString("name");

		if (_contains(ProductConstants.NAMES_SUBSCRIPTION, productName)) {
			return true;
		}

		return false;
	}

}