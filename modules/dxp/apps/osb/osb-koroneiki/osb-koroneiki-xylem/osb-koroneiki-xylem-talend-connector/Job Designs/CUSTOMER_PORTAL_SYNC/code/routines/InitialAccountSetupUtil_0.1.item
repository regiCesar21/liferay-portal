package routines;

/**
 * @author Amos Fong
 */
public class InitialAccountSetupUtil {

	public static String getActivationStatus(
		String accountKey, String name, String activationStatus) {

		if (name.equals(SubscriptionConstants.GROUP_NAME_ANALYTICS_CLOUD)) {
			if (_contains(accountKey)) {
				return "Active";
			}
		}
		else if (name.equals(
					SubscriptionConstants.
						GROUP_NAME_LIFERAY_EXPERIENCE_CLOUD)) {

			return "Active";
		}
		else if (name.equals(SubscriptionConstants.GROUP_NAME_LXC_SM)) {
			return "Active";
		}

		return activationStatus;
	}

	private static boolean _contains(String accountKey) {
		for (String activeAccountKey : _ACTIVE_ACCOUNT_KEYS) {
			if (activeAccountKey.equals(accountKey)) {
				return true;
			}
		}

		return false;
	}

	private static final String[] _ACTIVE_ACCOUNT_KEYS = {
		"KOR-117268541", "KOR-117563841", "KOR-116874320", "KOR-117461044",
		"KOR-116881480", "KOR-116859300", "KOR-117509913", "KOR-118018413",
		"KOR-117509815", "KOR-86488333", "KOR-116870149", "KOR-166495415",
		"KOR-168809579", "KOR-168625632", "KOR-169780861", "KOR-170561688",
