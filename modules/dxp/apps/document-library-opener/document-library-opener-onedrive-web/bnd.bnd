Bundle-Name: Liferay Document Library Opener OneDrive Web
Bundle-SymbolicName: com.liferay.document.library.opener.onedrive.web
Bundle-Version: 2.0.62
Import-Package:\
	!android.*,\
	\
	!com.sun.javadoc.*,\
	!com.sun.tools.javadoc.*,\
	\
	!kotlin.*,\
	\
	!net.sf.saxon.*,\
	\
	!org.apache.http.*,\
	\
	!org.bouncycastle.*,\
	\
	!org.conscrypt.*,\
	\
	!org.joda.time.*,\
	\
	!org.openjsse.javax.net.ssl.*,\
	!org.openjsse.net.ssl.*,\
	\
	*
Web-ContextPath: /document-library-opener-one-drive-web
-dsannotations-options: inherit