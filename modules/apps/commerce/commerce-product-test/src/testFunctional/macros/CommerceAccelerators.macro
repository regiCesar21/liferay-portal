definition {

	@summary = "Default summary"
	macro initializeNewSiteViaAccelerator(siteName = null, siteTemplateName = null) {
		ApplicationsMenu.gotoPortlet(
			category = "Sites",
			panel = "Control Panel",
			portlet = "Sites");

		if (isSet(siteTemplateName)) {
			Site.addCP(
				membershipType = "Private",
				siteName = ${siteName},
				siteTemplateName = ${siteTemplateName});
		}
		else {
			Site.addCP(
				membershipType = "Private",
				siteName = ${siteName},
				siteTemplateName = ${siteName});
		}
	}

}