Bundle-Version: 1.0.0
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.portal.impl)";\
		resource.bundle.base.name="content.Language"
-dsannotations-options: inherit